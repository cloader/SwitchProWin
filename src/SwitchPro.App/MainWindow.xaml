<Window x:Class="SwitchPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SwitchPro.App.Controls"
        Title="Switch Pro 控制软件" Height="740" Width="1180"
        MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <TabControl Margin="8" Background="Transparent" BorderThickness="0">

        <!-- ============ 控制器配置（Eden 风格） ============ -->
        <TabItem Header="控制器配置">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：连接控制器 | 输入设备 | 用户配置 -->
                <UniformGrid Columns="3">
                    <GroupBox Header="连接控制器" Margin="0,0,6,0">
                        <ComboBox IsEditable="False" Text="Pro Controller">
                            <ComboBoxItem IsSelected="True">Pro Controller</ComboBoxItem>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Header="输入设备" Margin="0,0,6,0">
                        <ComboBox x:Name="LiveDeviceBox" SelectionChanged="LiveDevice_Changed"/>
                    </GroupBox>
                    <GroupBox Header="用户配置">
                        <DockPanel>
                            <Button Content="保存" Width="52" Margin="4,0,0,0" DockPanel.Dock="Right" Click="SaveProfile_Click"/>
                            <Button Content="新建" Width="52" Margin="4,0,0,0" DockPanel.Dock="Right" Click="NewProfile_Click"/>
                            <Button Content="删除" Width="52" Margin="4,0,0,0" DockPanel.Dock="Right" Click="DeleteProfile_Click"/>
                            <ComboBox x:Name="ProfileBox" SelectionChanged="Profile_Changed"/>
                        </DockPanel>
                    </GroupBox>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="250"/>
                        <ColumnDefinition Width="1.55*" MinWidth="420"/>
                        <ColumnDefinition Width="*" MinWidth="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- ======== 左列（独立滚动） ======== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <GroupBox Header="ZL / L" Margin="0,0,0,8">
                            <UniformGrid Columns="2">
                                <StackPanel x:Name="PanelLT" Margin="0,0,4,0"/>
                                <StackPanel x:Name="PanelLB" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="左摇杆" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="校准向导" Height="24" Margin="0,0,0,6" Click="CalibrateLeft_Click"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="左" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                    <TextBlock Text="上" Grid.Column="1" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LeftAxisLeftCell" Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="LeftAxisLeft" Foreground="#1F2328"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="LeftAxisUp" Foreground="#1F2328"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="下" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                    <TextBlock Text="右" Grid.Column="1" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="LeftAxisDown" Foreground="#1F2328"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="LeftAxisRight" Foreground="#1F2328"/>
                                    </Border>
                                </Grid>
                                <WrapPanel Margin="2,6,2,2">
                                    <StackPanel x:Name="PanelLS" Margin="0,0,8,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="响应曲线" Foreground="#6B7076" FontSize="12"/>
                                        <ComboBox x:Name="LeftCurveBox" Width="120" SelectionChanged="Mapping_Changed"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="LeftDeadzoneLabel" Text="摇杆死区：10%" Foreground="#1F2328" Margin="4,8,0,2"/>
                                <Slider x:Name="LeftDeadzoneSlider" Minimum="0" Maximum="30" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Mapping_Changed" Margin="4,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="十字方向键" Margin="0,0,0,8">
                            <UniformGrid Columns="2">
                                <StackPanel x:Name="PanelDLeft" Margin="0,0,4,4"/>
                                <StackPanel x:Name="PanelDUp" Margin="4,0,0,4"/>
                                <StackPanel x:Name="PanelDDown" Margin="0,4,4,0"/>
                                <StackPanel x:Name="PanelDRight" Margin="4,4,0,0"/>
                            </UniformGrid>
                        </GroupBox>

                        <UniformGrid Columns="2">
                            <Button x:Name="BtnNintendoPreset" Content="Nintendo 预设" Margin="2,0,4,0" Click="NintendoPreset_Click"/>
                            <Button x:Name="BtnXboxPreset" Content="Xbox 预设" Margin="4,0,2,0" Click="XboxPreset_Click"/>
                        </UniformGrid>
                      </StackPanel>
                    </ScrollViewer>

                    <!-- ======== 中列：上下行固定，手柄图随空间等比缩放 ======== -->
                    <DockPanel Grid.Column="1" LastChildFill="True">
                        <UniformGrid Columns="3" DockPanel.Dock="Top" Margin="12,0">
                            <StackPanel x:Name="PanelBack" Margin="0,0,4,6"/>
                            <StackPanel x:Name="PanelStart" Margin="4,0,4,6"/>
                            <StackPanel x:Name="PanelGuide" Margin="4,0,0,6"/>
                        </UniformGrid>
                        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="170"/>
                                <ColumnDefinition Width="1.25*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="震动" Margin="4,0,4,0" Padding="6">
                                <StackPanel>
                                    <TextBlock x:Name="RumbleLabel" Text="50%" Foreground="#1F2328" HorizontalAlignment="Center"/>
                                    <Slider x:Name="RumbleSlider" Minimum="10" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="Mapping_Changed"/>
                                    <UniformGrid Columns="2" Margin="0,6,0,0">
                                        <Button Content="低频测试" Margin="0,0,3,3" Click="RumbleTest_Click" Tag="low"/>
                                        <Button Content="高频测试" Margin="3,0,0,3" Click="RumbleTest_Click" Tag="high"/>
                                        <Button Content="双马达" Margin="0,0,3,0" Click="RumbleTest_Click" Tag="both"/>
                                        <Button Content="停止" Margin="3,0,0,0" Click="RumbleTest_Click" Tag="stop"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="体感" Grid.Column="1" Margin="4,0,0,0" Padding="4">
                                <StackPanel>
                                    <ComboBox x:Name="GyroModeBox" SelectionChanged="Mapping_Changed">
                                        <ComboBoxItem Content="关闭"/>
                                        <ComboBoxItem Content="右摇杆瞄准"/>
                                        <ComboBoxItem Content="鼠标平移"/>
                                    </ComboBox>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="GyroActivateBox" SelectionChanged="Mapping_Changed"/>
                                        <Button Grid.Column="1" Content="校零" Width="44" Margin="4,0,0,0"
                                                Click="GyroCalibrate_Click"/>
                                    </Grid>
                                    <Slider x:Name="GyroSensSlider" Minimum="10" Maximum="300" TickFrequency="10"
                                            IsSnapToTickEnabled="True" ValueChanged="Mapping_Changed" Margin="0,4,0,0"/>
                                    <!-- 2×2 排列：组宽有限，单行放不下四个勾选框 -->
                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <CheckBox x:Name="GyroInvertXCheck" Content="反转X" FontSize="11"
                                                  Checked="Mapping_Changed" Unchecked="Mapping_Changed"/>
                                        <CheckBox x:Name="GyroInvertYCheck" Content="反转Y" FontSize="11"
                                                  Checked="Mapping_Changed" Unchecked="Mapping_Changed"/>
                                        <CheckBox x:Name="GyroSwapCheck" Content="交换轴" FontSize="11"
                                                  Checked="Mapping_Changed" Unchecked="Mapping_Changed" Margin="0,3,0,0"/>
                                        <CheckBox x:Name="GyroAutoCalCheck" Content="自动校零" FontSize="11"
                                                  Checked="Mapping_Changed" Unchecked="Mapping_Changed" Margin="0,3,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                        <Viewbox Stretch="Uniform" Margin="8,0" VerticalAlignment="Center">
                            <controls:ProControllerView x:Name="ControllerView"/>
                        </Viewbox>
                    </DockPanel>

                    <!-- ======== 右列（独立滚动） ======== -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <GroupBox Header="ZR / R" Margin="0,0,0,8">
                            <UniformGrid Columns="2">
                                <StackPanel x:Name="PanelRT" Margin="0,0,4,0"/>
                                <StackPanel x:Name="PanelRB" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="右摇杆" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Content="校准向导" Height="24" Margin="0,0,0,6" Click="CalibrateRight_Click"/>
                                <CheckBox x:Name="FlickStickCheck" Content="Flick Stick（甩杆瞄准：推杆即转向）" Margin="2,0,0,4"
                                          Checked="Mapping_Changed" Unchecked="Mapping_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="甩杆灵敏度" FontSize="11" Foreground="#6B7076"
                                               VerticalAlignment="Center" Margin="2,0,6,0"/>
                                    <Slider x:Name="FlickSensSlider" Grid.Column="1" Minimum="50" Maximum="200"
                                            TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Mapping_Changed"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="左" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                    <TextBlock Text="上" Grid.Column="1" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="RightAxisLeft" Foreground="#1F2328"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="RightAxisUp" Foreground="#1F2328"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="下" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                    <TextBlock Text="右" Grid.Column="1" Foreground="#6B7076" Margin="4,2" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="RightAxisDown" Foreground="#1F2328"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F2F3F5" CornerRadius="3" Margin="2" Padding="6,3">
                                        <TextBlock x:Name="RightAxisRight" Foreground="#1F2328"/>
                                    </Border>
                                </Grid>
                                <WrapPanel Margin="2,6,2,2">
                                    <StackPanel x:Name="PanelRS" Margin="0,0,8,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="响应曲线" Foreground="#6B7076" FontSize="12"/>
                                        <ComboBox x:Name="RightCurveBox" Width="120" SelectionChanged="Mapping_Changed"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="RightDeadzoneLabel" Text="摇杆死区：10%" Foreground="#1F2328" Margin="4,8,0,2"/>
                                <Slider x:Name="RightDeadzoneSlider" Minimum="0" Maximum="30" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Mapping_Changed" Margin="4,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="主要按键">
                            <UniformGrid Columns="2">
                                <StackPanel x:Name="PanelX" Margin="0,0,4,4"/>
                                <StackPanel x:Name="PanelA" Margin="4,0,0,4"/>
                                <StackPanel x:Name="PanelY" Margin="0,4,4,0"/>
                                <StackPanel x:Name="PanelB" Margin="4,4,0,0"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="按游戏自动切换" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBox x:Name="AutoSwitchBox" LostFocus="AutoSwitch_Changed"
                                         ToolTip="游戏进程名（不含 .exe），逗号分隔。前台运行时自动激活本配置"/>
                                <TextBlock Text="进程名用逗号分隔，如：deltagame,cs2" FontSize="11"
                                           Foreground="#6B7076" Margin="2,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="配置维护" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="导出当前配置" Margin="0,0,3,0" Click="ExportProfile_Click"/>
                                <Button Content="导入配置" Margin="3,0,0,0" Click="ImportProfile_Click"/>
                            </UniformGrid>
                        </GroupBox>
                      </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ============ 设备 ============ -->
        <TabItem Header="设备">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- 左：已连接设备 -->
                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock DockPanel.Dock="Top" Text="已连接设备" FontSize="14" FontWeight="SemiBold"
                               Margin="2,0,0,6"/>
                    <TextBlock x:Name="DeviceEmptyHint" DockPanel.Dock="Top" Margin="2,16,2,0"
                               Foreground="#8A8F96" TextWrapping="Wrap"
                               Text="未检测到手柄。USB 直插，或长按手柄背部配对键在系统蓝牙设置中配对，连接后将在此显示。"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F6F8" CornerRadius="6" Padding="12" Margin="2,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#666" Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <ProgressBar Height="10" Minimum="0" Maximum="100"
                                                            Value="{Binding BatteryPercent}" Foreground="#4CAF7E"/>
                                                <TextBlock Text="{Binding BatteryText}" Margin="0,4,0,0" Foreground="#444"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4" Background="#E4E6E9" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                <!-- 右：全局设置（按组分块） -->
                <StackPanel Grid.Column="2">
                    <GroupBox Header="常规" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="AutostartCheck" Content="开机自动启动（当前用户）"
                                      Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="闲置自动休眠：" VerticalAlignment="Center"/>
                                <ComboBox x:Name="IdleSleepBox" Width="104" SelectionChanged="IdleSleep_Changed">
                                    <ComboBoxItem Content="关闭"/>
                                    <ComboBoxItem Content="5 分钟"/>
                                    <ComboBoxItem Content="10 分钟"/>
                                    <ComboBoxItem Content="30 分钟"/>
                                    <ComboBoxItem Content="60 分钟"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="长时间无操作时手柄自动关机省电；Pro 手柄按任意键可重新唤醒回连。"
                                       FontSize="11" Foreground="#8A8F96" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Joy-Con 模式" Margin="0,0,0,8">
                        <StackPanel>
                            <RadioButton x:Name="JoyConPairRadio" GroupName="joycon" Content="配对（L + R 合为一副手柄）"
                                         Checked="JoyConMode_Changed"/>
                            <RadioButton x:Name="JoyConSingleRadio" GroupName="joycon" Content="单只独立（各为一副手柄）"
                                         Margin="0,6,0,0" Checked="JoyConMode_Changed"/>
                            <TextBlock Text="充电握把中的 Joy-Con 自动识别左右；更改模式后所有手柄将重新连接。"
                                       FontSize="11" Foreground="#8A8F96" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="组合键">
                        <StackPanel>
                            <CheckBox x:Name="ComboCycleCheck" Content="L+R+「−」　切换配置文件"
                                      Checked="Combo_Changed" Unchecked="Combo_Changed"/>
                            <CheckBox x:Name="ComboRecenterCheck" Content="L+R+「+」　陀螺仪重定心" Margin="0,6,0,0"
                                      Checked="Combo_Changed" Unchecked="Combo_Changed"/>
                            <TextBlock Text="游戏中无需切出即可切换配置或重新校零。"
                                       FontSize="11" Foreground="#8A8F96" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ============ 日志 ============ -->
        <TabItem Header="日志">
            <DockPanel Margin="4">
                <Button DockPanel.Dock="Top" Content="清空" Width="64" HorizontalAlignment="Left"
                        Margin="2,2,2,6" Click="ClearLog_Click"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Background="#FAFAFA"/>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
