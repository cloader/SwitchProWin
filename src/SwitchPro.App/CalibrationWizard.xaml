<Window x:Class="SwitchPro.App.CalibrationWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摇杆校准向导" Height="330" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF">
    <StackPanel Margin="16">
        <TextBlock x:Name="StepText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="准备校准左摇杆"/>
        <TextBlock x:Name="HintText" Foreground="#6B7076" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="按&quot;开始&quot;后按提示操作。校准保存在当前配置文件中，仅影响软件映射，不写入手柄。"/>
        <ProgressBar x:Name="Progress" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
        <Canvas Width="200" Height="200" Margin="0,10,0,0" HorizontalAlignment="Center">
            <Ellipse Canvas.Left="20" Canvas.Top="20" Width="160" Height="160"
                     Stroke="#C8CCD2" StrokeThickness="1" Fill="#FAFAFA"/>
            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="#3BA55D" Canvas.Left="91" Canvas.Top="91"/>
        </Canvas>
        <UniformGrid Columns="3" Margin="0,12,0,0">
            <Button x:Name="StartBtn" Content="开始" Margin="0,0,4,0" Click="Start_Click"/>
            <Button Content="重置为本体校准" Margin="0,0,4,0" Click="Reset_Click"/>
            <Button Content="关闭" Click="Close_Click"/>
        </UniformGrid>
    </StackPanel>
</Window>
