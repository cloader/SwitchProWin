<Application x:Class="SwitchPro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- 浅色主题（配色参考 Eden PlayerControlPreview 浅色分支） -->
        <SolidColorBrush x:Key="WindowBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F7F7F8"/>
        <SolidColorBrush x:Key="CellBg" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#C8CCD2"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#6B7076"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="#2E77C8"/>
        <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#3BA55D"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- GroupBox：圆角细边框 + 浅灰底（对应 Eden QGroupBox 样式） -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 槽位按钮：白底细边框，hover 蓝边，按下蓝底白字（对应 Eden QPushButton 样式） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HighlightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource HighlightTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource WindowBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Application.Resources>
</Application>
